{
  "manifest_version": 3,
  "name": "PhishLens",
  "version": "0.2.0",
  "description": "Explainable phishing detection for the Gmail web client. Shows a risk score, a severity tier, and the signals that produced them.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://api.usephishlens.app/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "content/parse.js",
        "content/panel.js",
        "content/gmail.js"
      ],
      "css": [
        "content/panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "PhishLens"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}