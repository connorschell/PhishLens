# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.env.*
!.env.example

# --- Data: raw corpora and derived artifacts are not versioned ---
01_Data/raw/
01_Data/processed/
01_Data/interim/
!01_Data/**/.gitkeep
!01_Data/**/*.md

# --- Models ---
# Large or regenerable artifacts stay out; the model bundles, the metrics and the
# written results are the record of what was measured, so they are versioned.
02_Model/results/*
!02_Model/results/*.md
!02_Model/results/model_*.json
!02_Model/results/metrics_*.json
!02_Model/results/.gitkeep
*.pkl
*.joblib
*.npy

# --- Office / OneDrive noise ---
~$*
*.tmp
.DS_Store
Thumbs.db

# --- Local-only compose overrides (port bindings, temporary exposure) ---
docker-compose.override.yml

# --- Secrets ---
05_Deployment/secrets/
*.pem
*.key

# --- Credentials: never commit. See 00_Admin/git-remote-access.md ---
.git_token
.secrets/
