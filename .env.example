# PhishLens environment template. Copy to .env and fill in. .env is gitignored.
POSTGRES_USER=phishlens
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=phishlens
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://phishlens:change_me_locally@db:5432/phishlens

# WBS 3.5 - Google Safe Browsing Lookup API. Left blank = graceful degradation.
SAFE_BROWSING_API_KEY=

# WBS 3.4 - server-side secret used to sign per-install tokens. Never shipped to the extension.
TOKEN_SIGNING_SECRET=change_me_locally

API_ENV=development
LOG_LEVEL=INFO
